<Window x:Class="Pc_parts_lister.bin.Edit_Parameters_window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Pc_parts_lister.bin"
        xmlns:properties="clr-namespace:Pc_parts_lister.Resources"
        mc:Ignorable="d"
        Title="Edit_Parameters_window" Height="450" Width="450">
    <Grid>
        <Button Click="AddButton_Click" Margin="5" VerticalAlignment="Top" HorizontalAlignment="Right" Height="30" Width="30">
            <Button.Background>
                <ImageBrush ImageSource="/add_button.png"/>
            </Button.Background>
        </Button>
        <DataGrid ItemsSource="{Binding ParametersView}" AutoGenerateColumns="False" CanUserAddRows="False" Margin="0,50,0,0" Name="Parameters_grid">
            <DataGrid.Columns>

                <DataGridTextColumn Header="{x:Static properties:Strings.Name}" Binding="{Binding Name}" IsReadOnly="True"/>
                <DataGridTextColumn Header="{x:Static properties:Strings.ID}" Binding="{Binding ID}" IsReadOnly="True"/>

                <!-- Tlačítka -->
                <DataGridTemplateColumn Header="{x:Static properties:Strings.Actions}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="{x:Static properties:Strings.Edit}" Margin="2" Background="DarkBlue" Foreground="White" Click="EditButton_Click"/>

                                <Button Content="{x:Static properties:Strings.Delete}" Margin="2" Background="DarkRed" Foreground="White" Click="DeleteButton_Click"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
