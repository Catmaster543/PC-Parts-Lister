<Window x:Class="Pc_parts_lister.bin.Edit_Parameters_window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Pc_parts_lister.bin"
        mc:Ignorable="d"
        Title="Edit_Parameters_window" Height="450" Width="450">
    <Grid>
        <DataGrid ItemsSource="{Binding ParametersView}" AutoGenerateColumns="False" CanUserAddRows="False" Margin="50" Name="Component_grid">
            <DataGrid.Columns>

                <DataGridTextColumn Header="Název" Binding="{Binding Name}" IsReadOnly="True"/>
                <DataGridTextColumn Header="ID" Binding="{Binding ID}" IsReadOnly="True"/>

                <!-- Tlačítka -->
                <DataGridTemplateColumn Header="Akce">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="Upravit" Margin="2" Background="DarkBlue" Foreground="White" Click="EditButton_Click"/>

                                <Button Content="Smazat" Margin="2" Background="DarkRed" Foreground="White" Click="DeleteButton_Click"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
