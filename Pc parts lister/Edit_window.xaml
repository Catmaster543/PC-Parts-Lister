<Window x:Class="Pc_parts_lister.Edit_window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Pc_parts_lister"
        mc:Ignorable="d"
        Title="Edit Window" Height="900" Width="800">
    
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="3*" />
            <RowDefinition Height="*"/>
            <RowDefinition Height="1.9*"/>
            <RowDefinition Height="0.5*"/>
            <RowDefinition Height="0.7*"/>
        </Grid.RowDefinitions>

        <Border BorderBrush="Gray" Grid.ColumnSpan="2" Grid.Row="0" BorderThickness="0,0,0,2">
            <StackPanel>
                <Button Click="Back_Click" Height="30" Width="30" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10,10,10,0">
                    <Button.Background>
                        <ImageBrush Stretch="UniformToFill" ImageSource="/back_button.png"/>
                    </Button.Background>
                </Button>
                <TextBox Text="{Binding Name}" FontSize="36" FontWeight="Bold" BorderThickness="0"/>
            </StackPanel>
        </Border>

        <StackPanel Name="Parameters_Panel" Margin="10" Grid.Column="1" Grid.Row="1" Grid.RowSpan="2">
            
        </StackPanel>
        <StackPanel Name="MainImagePanel" Margin="10" Grid.Column="0" Grid.Row="1">
            <Button x:Name="MainPicButton" Height="270" Tag="{Binding FullImagePath}" BorderThickness="0" Background="{x:Null}">
                <Image Name="Main_Pic" Source="{Binding FullImagePath}" Stretch="Uniform"/>
            </Button>
            <Button Name="SelectMainPic_Button" Content="Vybrat obrázek" Click="SelectImage_Click" BorderThickness="0,0,0,0" FontSize="20" FontWeight="Bold" Height="29"/>
        </StackPanel>
        <Button Name="EditMainPic_Button" Click="EditMainPic_Click" Grid.Column="0" Grid.Row="1" Margin="7" Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Top" BorderThickness="0" FontSize="20" FontWeight="Bold" Visibility="Collapsed">
            <Button.Background>
                <ImageBrush ImageSource="/edit_button.png" Stretch="Uniform"/>
            </Button.Background>
        </Button>


        <ScrollViewer Grid.Column="0" Grid.Row="2" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto" HorizontalContentAlignment="Center">
            <StackPanel Name="ImagesPanel" Margin="7" CanVerticallyScroll="False" Orientation="Horizontal">
                <Button Click="AddImage_Click" Width="60" Height="60" Margin="7,0,0,0">
                    <Button.Background>
                        <ImageBrush ImageSource="/add_button.png"/>
                    </Button.Background>
                </Button>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Name="Editor_StackPanel" Margin="10" Grid.Row="3" Grid.Column="0">
            <Border BorderBrush="Gray" BorderThickness="1">
                <StackPanel Orientation="Horizontal" Margin="5">
                    <Button Width="30" Height="30" BorderThickness="0" Click="Bold_ButtonClick">
                        <Button.Background>
                            <ImageBrush ImageSource="/bold_button_on.png" />
                        </Button.Background>
                    </Button>
                    <Button Width="30" Height="30" BorderThickness="0" Click="Italic_ButtonClick">
                        <Button.Background>
                            <ImageBrush ImageSource="/italic_button_on.png" />
                        </Button.Background>
                    </Button>
                    <Button Width="30" Height="30" BorderThickness="0" Click="BoldnItalic_ButtonClick">
                        <Button.Background>
                            <ImageBrush ImageSource="/bolditalic_button_on.png" />
                        </Button.Background>
                    </Button>
                    <Button Width="30" Height="30" BorderThickness="0" Click="Heading_ButtonClick">
                        <Button.Background>
                            <ImageBrush ImageSource="/header_button.png"/>
                        </Button.Background>
                    </Button>
                    <Button Width="30" Height="30" BorderThickness="0" Click="Heading2_ButtonClick">
                        <Button.Background>
                            <ImageBrush ImageSource="/header2_button.png"/>
                        </Button.Background>
                    </Button>
                </StackPanel>
            </Border>
            
            <TextBox Name="Description_TextBox" TextChanged="DescriptionBox_TextChanged" Width="auto" Height="auto" TextWrapping="Wrap" AcceptsReturn="True" Text="{Binding Description}"/>
        </StackPanel>
        
        <FlowDocumentScrollViewer Name="Preview_FlowDoc" Margin="10" Grid.Row="3" Grid.Column="1" Width="auto" Height="auto"/>

        <StackPanel Grid.ColumnSpan="2" Grid.Row="4">
            <Button Content="Uložit" Name="Save_Button" Margin="5" Click="Save_Click" FontWeight="Bold" FontSize="25" Background="SpringGreen"/>
        </StackPanel>

        <StackPanel x:Name="ErrorPanel" Grid.Row="5" Grid.ColumnSpan="2">
            
        </StackPanel>
    </Grid>
</Window>
