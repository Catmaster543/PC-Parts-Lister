<Window x:Class="Pc_parts_lister.Parameter_Rules_window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Pc_parts_lister"
        xmlns:properties="clr-namespace:Pc_parts_lister.Resources"
        mc:Ignorable="d"
        Title="ParameterRules" Height="450" Width="800" ResizeMode="NoResize">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <Button Click="AddParameterRule_Click" Margin="5" VerticalAlignment="Top" HorizontalAlignment="Left" Height="30" Width="30">
            <Button.Background>
                <ImageBrush ImageSource="/add_button.png"/>
            </Button.Background>
        </Button>
        <ListBox Name="ValuesListBox" ItemsSource="{Binding ParameterRulesView}" SelectionChanged="RulesListBox_SelectionChanged" Margin="10, 50, 10, 10">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Click="DeleteButton_Click" Grid.Column="1" Margin="5,0,0,0" Width="17" Height="17">
                            <Button.Background>
                                <ImageBrush ImageSource="/cancel_button.png"/>
                            </Button.Background>
                        </Button>
                        <TextBlock Text="{Binding}" FontSize="12" FontWeight="SemiBold" Grid.Column="0"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <!-- DataGrid ItemsSource="{Binding ParameterRulesView}" AutoGenerateColumns="False" CanUserAddRows="False" Margin="10,50,10,10" Name="Parameters_grid">
            <DataGrid.Columns>

                <DataGridTextColumn Header="{x:Static properties:Strings.Parameter}" Binding="{Binding dependentParameter}"/>

                <DataGridTemplateColumn Header="{x:Static properties:Strings.Value}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <ComboBox Margin="10,0,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="{x:Static properties:Strings.Actions}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="{x:Static properties:Strings.Delete}" Margin="2" Background="DarkRed" Foreground="White" Click="DeleteButton_Click"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid-->
        <Grid Name="Edit_Grid" Visibility="Collapsed" Grid.Column="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Margin="10">
                <TextBlock Text="{x:Static properties:Strings.Parameter}" FontWeight="SemiBold"/>
                <ComboBox Name="Parameter_ComboBox" SelectionChanged="ParameterComboBox_SelectionChanged" BorderThickness="0"/>
            </StackPanel>
            <StackPanel Visibility="Hidden" Name="Value_Panel" Grid.Column="1" Margin="10">
                <TextBlock Text="{x:Static properties:Strings.Value}" FontWeight="SemiBold"/>
                <StackPanel Visibility="Collapsed" Name="ComboBoxPType_Panel" Orientation="Horizontal">
                    <ComboBox Name="Value_ComboBox" SelectionChanged="ValueComboBox_SelectionChanged" BorderThickness="0"/>
                    <Button Margin="20,0,0,0" HorizontalAlignment="Right" Width="20" Height="20" BorderThickness="0">
                        <Button.Background>
                            <ImageBrush ImageSource="/cancel_button.png"/>
                        </Button.Background>
                    </Button>
                </StackPanel>
                <StackPanel Visibility="Collapsed" Name="TextPType_Panel" Orientation="Horizontal">
                    <TextBox Name="Value_TextBox" TextChanged="ValueTextBox_TextChanged" MinWidth="50" BorderThickness="0,0,0,2"/>
                    <Button Margin="20,0,0,0" HorizontalAlignment="Right" Width="20" Height="20" BorderThickness="0">
                        <Button.Background>
                            <ImageBrush ImageSource="/cancel_button.png"/>
                        </Button.Background>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
