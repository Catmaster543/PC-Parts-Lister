<Window x:Class="Pc_parts_lister.Edit_Parameter_window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Pc_parts_lister"
        mc:Ignorable="d"
        Title="Edit_Parameter_window" Height="400" Width="300">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="5*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Name="Main_Panel" Margin="10">
            <StackPanel Name="Name_panel" Margin="10" Orientation="Horizontal">
                <TextBlock FontSize="16" Text="Jméno" FontWeight="Bold"/>
                <TextBox Name="Name_Box" FontSize="16" MinWidth="20" BorderThickness="0,0,0,2" Margin="5,0,0,0"/>
            </StackPanel>
            <StackPanel Name="ID_panel" Margin="10" Orientation="Horizontal">
                <TextBlock FontSize="16" Text="ID" FontWeight="Bold"/>
                <TextBox Name="ID_Box" FontSize="16" MinWidth="20" BorderThickness="0,0,0,2" Margin="5,0,0,0"/>
            </StackPanel>
            <StackPanel Name="Type_panel" Margin="10" Orientation="Horizontal">
                <TextBlock FontSize="16" Text="Typ" FontWeight="Bold"/>
                <ComboBox Name="Type_Box" FontSize="16" MinWidth="20" BorderThickness="0,0,0,2" Margin="5,0,0,0" SelectionChanged="TypeBox_SelectionChanged"/>
            </StackPanel>
            <Grid>
                <StackPanel Name="String_Option_Panel" Margin="10" Visibility="Hidden">
                    <StackPanel Orientation="Horizontal">
                        <CheckBox Checked="List_String_CheckBox_Checked" Unchecked="List_String_CheckBox_Unchecked"/>
                        <TextBlock FontSize="10" Text="Seznam položek" FontWeight="Bold" Margin="3,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <CheckBox Checked="Custom_String_CheckBox_Checked" Unchecked="Custom_String_CheckBox_Unchecked"/>
                        <TextBlock FontSize="10" Text="Povolit vlastní hodnotu" FontWeight="Bold" Margin="3,0,0,0"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Name="Int_Option_Panel" Margin="10" Visibility="Hidden">
                    <StackPanel Orientation="Horizontal">
                        <CheckBox Checked="CustomAfterFix_CheckBox_Checked" Unchecked="CustomAfterFix_CheckBox_Unchecked"/>
                        <TextBlock FontSize="10" Text="Extra koncovka" FontWeight="Bold" Margin="3,0,0,0"/>
                    </StackPanel>
                    <StackPanel Name="CustomAfterFix_panel" Orientation="Horizontal" Visibility="Hidden">
                        <TextBlock FontSize="10" Text="Koncovka" FontWeight="Bold"/>
                        <TextBox Name="CustomAfterFix_Box" FontSize="10" MinWidth="20" BorderThickness="0,0,0,2" Margin="5,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="10">
            <Button Content="Uložit" Click="Save_Click" FontWeight="Bold" FontSize="16" Background="SpringGreen"/>
        </StackPanel>
    </Grid>
</Window>
